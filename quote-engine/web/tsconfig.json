{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": [],
    // Typechecks against the real mock so the stub can never drift from the
    // contract. Which module actually compiles into a build is decided by the
    // matching alias in vite.config.ts.
    "paths": {
      "@preview-api": ["./src/api/mock.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "globals.d.ts"]
}
